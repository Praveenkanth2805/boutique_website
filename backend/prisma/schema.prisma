generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  mobile     String
  address    String?
  pincode    String?
  isVerified Boolean  @default(false)
  otp        String?
  otpExpiry  DateTime?
  createdAt  DateTime @default(now())
  enquiries  Enquiry[]
}

model Admin {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  otpVerified Boolean  @default(false)
  otp         String?
  otpExpiry   DateTime?
  createdAt   DateTime @default(now())
}

model Service {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  price       Float
  createdAt   DateTime       @default(now())
  images      ServiceImage[]
  enquiries   Enquiry[]
}

model ServiceImage {
  id         Int      @id @default(autoincrement())
  serviceId  Int
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  imageUrl   String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Enquiry {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  serviceId  Int?
  service    Service? @relation(fields: [serviceId], references: [id])
  name       String
  address    String
  pincode    String
  mobile     String
  createdAt  DateTime @default(now())
}