generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  password   String
  mobile     String
  address    String?
  pincode    String?
  isVerified Boolean   @default(false)
  otp        String?
  otpExpiry  DateTime?
  createdAt  DateTime  @default(now())
  enquiries  Enquiry[]  // opposite of Enquiry.user
}

model Admin {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  otpVerified Boolean   @default(false)
  otp         String?
  otpExpiry   DateTime?
  createdAt   DateTime  @default(now())
}

model Service {
  id          Int             @id @default(autoincrement())
  title       String
  description String?         // optional
  thumbnail   String          // one image URL for service listing
  category    String          @default("uncategorized")
  createdAt   DateTime        @default(now())
  designs     ServiceDesign[] // opposite of ServiceDesign.service
}

model ServiceDesign {
  id          Int          @id @default(autoincrement())
  serviceId   Int
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  imageUrl    String       // design image
  price       Float        // required
  description String?      // optional per design
  createdAt   DateTime     @default(now())
  enquiries   Enquiry[]    // opposite of Enquiry.design
}

model Enquiry {
  id        Int           @id @default(autoincrement())
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id])
  designId  Int
  design    ServiceDesign @relation(fields: [designId], references: [id])
  name      String
  address   String
  pincode   String
  mobile    String
  createdAt DateTime      @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}